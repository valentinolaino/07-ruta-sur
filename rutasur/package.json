{
  "name": "rutasur",
  "version": "1.0.0",
  "description": "RutaSur - logística orientada a eventos (Kafka, Node.js, PostgreSQL, Next.js)",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/arrancar.js",
    "verificar": "node shared/verificar.js",
    "simulador": "node simulador/simulador.js",
    "escenario": "node simulador/escenario.js",
    "proyector": "node servicios/proyector/index.js",
    "notificaciones": "node servicios/notificaciones/index.js",
    "reprogramacion": "node servicios/reprogramacion/index.js",
    "monitor": "node servicios/monitor-sla/index.js",
    "analitica": "node servicios/analitica/index.js",
    "analitica:tiempos": "node servicios/analitica/tiempos.js",
    "todo": "node scripts/todos.js",
    "reconstruir": "node scripts/reconstruir.js",
    "test": "node --test shared/eventos.test.js simulador/plan.test.js servicios/proyector/reducer.test.js servicios/servicios.test.js servicios/monitor-sla/evaluar.test.js servicios/analitica/indicadores.test.js",
    "lag": "node scripts/lag.js",
    "reconstruir:envios": "node scripts/reconstruir.js --solo-proyector"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.0"
  }
}
